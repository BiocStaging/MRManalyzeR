# History files
.Rhistory
.Rapp.history

CLAUDE.md
.claude/
AGENTS.md

# Scratch figures (workflow drafts) — keep local only. The logo is tracked:
# it ships in the tarball and the README points at it.
man/figures/*
!man/figures/logo.png

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~
temp_res/

# RStudio Connect folder
rsconnect/
combine_data_helpers.R
inst/doc

# BiocCheck output folder (regenerated each run)
MRManalyzeR.BiocCheck/
/doc/
/Meta/

# RStudio project file - kept local, not part of the package
*.Rproj

# Scratch drivers and experiments. Already excluded from the tarball by
# .Rbuildignore; ignored here too so `git add -A` cannot sweep them onto the
# submission branch.
_*

# pkgdown site assets (favicons). Site source rather than package source, and
# Bioconductor asks that application-specific files stay off the branch.
pkgdown/
